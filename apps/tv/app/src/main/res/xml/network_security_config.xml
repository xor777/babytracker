<?xml version="1.0" encoding="utf-8"?>
<!--
  Сервер живёт в локалке по http://<ip>:8787 — на Android 9+ открытый HTTP по умолчанию
  запрещён, и страница просто не откроется. Разрешаем cleartext явно.
-->
<network-security-config>
    <!--
      Доверяем только системным CA. Пользовательские сертификаты НЕ добавляем:
      дашборд переезжает на настоящий HTTPS, и любой подсунутый на телевизор CA
      иначе штатно ломал бы TLS.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
      Публичный домен — только HTTPS, никакого cleartext. Формат конфигурации
      не умеет диапазоны адресов, поэтому «разрешить http только в локалке»
      одним правилом не выразить: cleartext остаётся в base-config ради
      http://192.168.x.x:8787, а downgrade внешнего домена закрывается точечно.
      Домен сменится — поправить здесь.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">adbgw.ru</domain>
    </domain-config>
</network-security-config>
