<?xml version="1.0" encoding="utf-8"?>
<!--
  Штатный адрес дашборда — https://bt.nuanu.ai/ (через Cloudflare). Но для локальной
  разработки сервер поднимают по http://<ip>:8787, а на Android 9+ открытый HTTP
  запрещён по умолчанию и такая страница просто не откроется — разрешаем cleartext
  явно, и тут же закрываем его для публичных доменов (см. domain-config ниже).
-->
<network-security-config>
    <!--
      Доверяем только системным CA. Пользовательские сертификаты НЕ добавляем:
      дашборд отдаётся по настоящему HTTPS, и любой подсунутый на телевизор CA
      иначе штатно ломал бы TLS.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
      Публичные домены — только HTTPS, никакого cleartext. Формат конфигурации
      не умеет диапазоны адресов, поэтому «разрешить http только в локалке»
      одним правилом не выразить: cleartext остаётся в base-config ради
      http://192.168.x.x:8787, а downgrade внешних доменов закрывается точечно.

      nuanu.ai   — путь через Cloudflare, сюда ходит телевизор;
      adbgw.ru   — прямой путь на IP, вебхук Алисы; телевизор туда не ходит,
                   но сервер по нему отвечает, и строгий HTTPS нужен и там.
      Появится третий домен — дописать сюда же.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">nuanu.ai</domain>
        <domain includeSubdomains="true">adbgw.ru</domain>
    </domain-config>
</network-security-config>
