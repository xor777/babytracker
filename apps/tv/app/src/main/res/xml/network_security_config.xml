<?xml version="1.0" encoding="utf-8"?>
<!--
  Сервер живёт в локалке по http://<ip>:8787 — на Android 9+ открытый HTTP по умолчанию
  запрещён, и страница просто не откроется. Разрешаем cleartext явно.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
