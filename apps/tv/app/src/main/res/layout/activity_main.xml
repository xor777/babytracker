<?xml version="1.0" encoding="utf-8"?>
<!--
  keepScreenOn на корне + FLAG_KEEP_SCREEN_ON в коде: дашборд висит сутками,
  телевизор не должен уходить в заставку.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bt_bg"
    android:keepScreenOn="true">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bt_bg"
        android:visibility="invisible" />

    <!-- Экран состояния: подключение / ошибка. Перекрывает WebView целиком,
         чтобы пользователь никогда не видел белую страницу ошибки движка. -->
    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bt_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="64dp"
        android:paddingTop="32dp"
        android:paddingRight="64dp"
        android:paddingBottom="32dp">

        <View
            android:layout_width="120dp"
            android:layout_height="3dp"
            android:layout_marginBottom="20dp"
            android:background="@color/bt_cyan" />

        <TextView
            android:id="@+id/overlayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.18"
            android:text="@string/connecting_title"
            android:textColor="@color/bt_cyan"
            android:textSize="42sp" />

        <TextView
            android:id="@+id/overlayDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/connecting_detail"
            android:textColor="@color/bt_text"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/overlayUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textColor="@color/bt_magenta"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/overlayStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:fontFamily="monospace"
            android:text="@string/connecting_status"
            android:textColor="@color/bt_text"
            android:textSize="26sp" />
    </LinearLayout>

    <!-- Подсказка по пульту живёт в подвале, а не в центральной колонке:
         иначе на экранах пониже её съедает нехватка высоты. -->
    <TextView
        android:id="@+id/overlayHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:text="@string/error_hint"
        android:textColor="@color/bt_dim"
        android:textSize="20sp"
        android:visibility="gone" />

</FrameLayout>
