<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Без leanback приложение не считается TV-приложением. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <!-- У телевизора нет тачскрина: required=false обязателен, иначе установка отвалится. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.BabyTrackerTv">

        <activity
            android:name=".MainActivity"
            android:banner="@drawable/banner"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|navigation|density|fontScale|locale|layoutDirection"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.BabyTrackerTv">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Главное: без LEANBACK_LAUNCHER иконки в лаунчере Android TV не будет. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <!-- Про запас: запуск на обычном планшете/эмуляторе при отладке. -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
