{
  "name": "@babytracker/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BabyTracker: webhook Алисы, REST + SSE, очередь LLM-разбора, MCP-сервер",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "mcp": "node --env-file-if-exists=.env src/mcp-server.ts",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.1.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "fastify": "^5.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
