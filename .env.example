# --- сервер ---
PORT=8787
TZ=Europe/Moscow
DB_PATH=./data/babytracker.db

# --- Алиса ---
# 32 hex-символа, часть URL вебхука: https://<host>/alice/<ALICE_WEBHOOK_SECRET>
# Сгенерировать: openssl rand -hex 16
ALICE_WEBHOOK_SECRET=
# ID навыка из консоли Яндекс Диалогов. Пусто = проверка отключена.
ALICE_SKILL_ID=
# Через запятую. Сверяется со всеми тремя полями идентичности из запроса.
# Пусто = доверие первому: первое обращение запоминается как владелец
# (в БД, переживает перезапуск), дальше новые устройства подтверждаются
# из админки — POST /api/alice/pending/<id>/trust или /api/alice/enroll.
# ВНИМАНИЕ: опознание идёт по session.user.user_id (аккаунт Яндекса),
# а не по устаревшему session.user_id — он у каждой колонки свой.
ALICE_ALLOWED_USER_IDS=

# false — не сверять идентичность вовсе, только фиксировать обращения.
# Настоящая защита вебхука это секрет в пути; идентичность — второй рубеж.
ALICE_IDENTITY_CHECK=true

# --- ребёнок ---
CHILD_NAME=Андрей
CHILD_BIRTHDATE=2026-03-01

# --- claude worker ---
CLAUDE_BIN=claude
# Сильная модель: она пишет SQL по свободной русской фразе и правит данные.
# Работает через подписку Claude (OAuth), а не по API-ключу — вызовы входят
# в стоимость подписки. ANTHROPIC_API_KEY в окружении быть НЕ должно.
CLAUDE_MODEL=claude-opus-5
# Уровень усилия модели: low | medium | high | xhigh | max.
# Закреплён ЯВНО, а не унаследован от CLI: умолчание CLI меняется между
# версиями молча, а этот конвейер пишет данные о ребёнке.
CLAUDE_EFFORT=high
WORKER_ENABLED=true

# Когда звать модель. all (по умолчанию) = на каждую фразу: словарь матчера
# слишком часто уверен в неверном прочтении, и его уверенность не повод молчать.
# smart = только непонятые фразы и команды управления данными («удали»,
# «отмени», «исправь»). unknown = самый экономный режим.
LLM_QUEUE_POLICY=all
LLM_CONFIDENCE_THRESHOLD=0.8

# --- доступ: авторизация устройств по коду (CONTRACT §11) ---
# Кука сессии с флагом Secure. false — ТОЛЬКО локальная разработка без TLS:
# без Secure секрет уходит по http открытым текстом. Сервер предупреждает на старте.
AUTH_COOKIE_SECURE=true
# Срок жизни короткого кода сопряжения, секунды (60..3600). Компромисс из RFC 8628 §5.4:
# достаточно, чтобы дойти до телефона, и мало, чтобы подсмотренный код успел пригодиться.
PAIR_CODE_TTL_SEC=600
# Скользящий срок сессии телефона в днях, от последнего обращения.
# Сессия телевизора БЕССРОЧНА независимо от этого значения: протухшая означала бы
# код сопряжения вместо дневника однажды утром. Телевизор отключается только отзывом.
SESSION_TTL_DAYS=90

# --- интерфейсы ---
DASHBOARD_ORIGIN=http://localhost:5173

# Каталоги собранной статики. Дашборд телевизора раздаётся по «/»,
# админка — по «/dash». Каталога нет — сервер просто не отдаёт этот путь
# и пишет одну строку в лог; API и вебхук работают как обычно.
# Относительные пути считаются от рабочего каталога сервера (apps/server).
# Значения ниже совпадают с умолчаниями, задавать их не обязательно.
# DASHBOARD_DIST=../dashboard/dist
# ADMIN_DIST=../admin/dist
