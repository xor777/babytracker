# --- сервер ---
PORT=8787
TZ=Europe/Moscow
DB_PATH=./data/babytracker.db

# --- Алиса ---
# 32 hex-символа, часть URL вебхука: https://<host>/alice/<ALICE_WEBHOOK_SECRET>
# Сгенерировать: openssl rand -hex 16
ALICE_WEBHOOK_SECRET=
# ID навыка из консоли Яндекс Диалогов. Пусто = проверка отключена.
ALICE_SKILL_ID=
# Через запятую. Пусто = принимать всех (режим первичной настройки:
# сервер напишет в лог увиденный user_id, его надо сюда вписать).
ALICE_ALLOWED_USER_IDS=

# --- ребёнок ---
CHILD_NAME=Андрей
CHILD_BIRTHDATE=2026-03-01

# --- claude worker ---
CLAUDE_BIN=claude
# Сильная модель: она пишет SQL по свободной русской фразе и правит данные.
# Работает через подписку Claude (OAuth), а не по API-ключу — вызовы входят
# в стоимость подписки. ANTHROPIC_API_KEY в окружении быть НЕ должно.
CLAUDE_MODEL=claude-opus-5
WORKER_ENABLED=true

# Когда звать модель. smart = только непонятые фразы и команды управления
# данными («удали», «отмени», «исправь»). all = на каждую фразу: качество выше,
# но быстрее расходуется окно лимита подписки. unknown = самый экономный режим.
LLM_QUEUE_POLICY=smart
LLM_CONFIDENCE_THRESHOLD=0.8

# --- интерфейсы ---
DASHBOARD_ORIGIN=http://localhost:5173

# Каталоги собранной статики. Дашборд телевизора раздаётся по «/»,
# админка — по «/dash». Каталога нет — сервер просто не отдаёт этот путь
# и пишет одну строку в лог; API и вебхук работают как обычно.
# Относительные пути считаются от рабочего каталога сервера (apps/server).
# Значения ниже совпадают с умолчаниями, задавать их не обязательно.
# DASHBOARD_DIST=../dashboard/dist
# ADMIN_DIST=../admin/dist
