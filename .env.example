# --- сервер ---
PORT=8787
TZ=Europe/Moscow
DB_PATH=./data/babytracker.db

# --- Алиса ---
# 32 hex-символа, часть URL вебхука: https://<host>/alice/<ALICE_WEBHOOK_SECRET>
# Сгенерировать: openssl rand -hex 16
ALICE_WEBHOOK_SECRET=
# ID навыка из консоли Яндекс Диалогов. Пусто = проверка отключена.
ALICE_SKILL_ID=
# Через запятую. Пусто = принимать всех (режим первичной настройки:
# сервер напишет в лог увиденный user_id, его надо сюда вписать).
ALICE_ALLOWED_USER_IDS=

# --- ребёнок ---
CHILD_NAME=Андрей
CHILD_BIRTHDATE=2026-03-01

# --- claude worker ---
CLAUDE_BIN=claude
CLAUDE_MODEL=claude-sonnet-5
WORKER_ENABLED=true

# --- dashboard ---
DASHBOARD_ORIGIN=http://localhost:5173
